---
// Jarvis, the assistant's face: an original holographic HUD ring (cool cyan light on dark glass), not any film's design.
// Reacts to the assistant state on its [data-assistant] ancestor: rings drift slowly when idle, brighten while listening,
// the scan arc spins while thinking, and the core pulses with the voice. --lvl (0..1, set by src/scripts/assistant.ts)
// drives the core and the glow.
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<span class="jarvis" style={`--size:${size}px`} aria-hidden="true" data-ai-level>
  <svg viewBox="0 0 40 40">
    <defs>
      <radialGradient id="jarvis-core" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#fff" />
        <stop offset=".45" stop-color="#bff3ff" />
        <stop offset="1" stop-color="#36c8f4" />
      </radialGradient>
    </defs>
    <circle class="outer" cx="20" cy="20" r="16.6" pathLength="100" />
    <circle class="ticks" cx="20" cy="20" r="13.4" pathLength="120" />
    <circle class="scan" cx="20" cy="20" r="10.2" pathLength="100" />
    <circle class="halo" cx="20" cy="20" r="7.4" />
    <circle class="core" cx="20" cy="20" r="4.8" fill="url(#jarvis-core)" />
  </svg>
</span>

<style>
  .jarvis {
    --lvl: 0;
    --cyan: #4fd8ff;
    position: relative; flex: none; display: inline-block; width: var(--size); height: var(--size); border-radius: 50%;
    /* dark glass disc with a faint cyan rim */
    background: radial-gradient(circle at 50% 45%, #10283b 0%, #081522 58%, #04090f 100%);
    box-shadow:
      inset 0 0 0 .5px rgb(79 216 255 / .45),
      inset 0 1px 1px rgb(255 255 255 / .18),
      0 0 0 .5px rgb(0 0 0 / .35),
      0 3px 10px -3px rgb(0 0 0 / .45),
      0 0 calc(4px + var(--lvl) * var(--size) * .45) calc(var(--lvl) * var(--size) * .08) rgb(79 216 255 / calc(.18 + var(--lvl) * .45));
    transition: box-shadow .1s linear;
  }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  circle { fill: none; transform-box: fill-box; transform-origin: center; }
  /* Segmented outer ring, drifting clockwise */
  .outer { stroke: var(--cyan); stroke-width: 1.1; stroke-dasharray: 18 4 6 4 30 4 10 4 20 0; opacity: .75; animation: spin 24s linear infinite; }
  /* Fine tick ring, drifting the other way */
  .ticks { stroke: var(--cyan); stroke-width: 1.6; stroke-dasharray: .7 2.3; opacity: .45; animation: spin 36s linear infinite reverse; }
  /* Scan arc: two short arcs that sweep */
  .scan { stroke: #9beaff; stroke-width: 1.3; stroke-linecap: round; stroke-dasharray: 22 28; opacity: .8; animation: spin 7s linear infinite; }
  .halo { fill: rgb(79 216 255 / .14); stroke: rgb(79 216 255 / .5); stroke-width: .5; scale: calc(1 + var(--lvl) * .25); transition: scale .1s linear; }
  .core { fill: url(#jarvis-core); scale: calc(.92 + var(--lvl) * .4); animation: breathe 3.2s ease-in-out infinite; transition: scale .1s linear; }

  @keyframes spin { to { rotate: 360deg; } }
  @keyframes breathe { 50% { opacity: .78; } }

  /* Listening: everything brightens and the ticks quicken */
  :global(.assistant[data-state="listening"]) .outer { opacity: 1; }
  :global(.assistant[data-state="listening"]) .ticks { opacity: .8; animation-duration: 10s; }
  /* Thinking: the scan arc spins fast */
  :global(.assistant[data-state="thinking"]) .scan { animation-duration: .9s; opacity: 1; }
  :global(.assistant[data-state="thinking"]) .outer { animation-duration: 6s; }
  /* Speaking: the core follows the voice instead of breathing */
  :global(.assistant[data-state="speaking"]) .core { animation: none; }
</style>
