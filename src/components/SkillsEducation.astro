---
import { skills } from '../data/skills';
---
<dl class="skills">
  {skills.map((g) => (
    <div class="row">
      <dt class="small muted">{g.group}</dt>
      <dd>{g.items.join(', ')}</dd>
    </div>
  ))}
</dl>

<style>
  .skills { display: grid; gap: var(--s-6) var(--s-7); }
  @container (min-width: 680px) { .skills { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container (min-width: 920px) { .skills { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .row { display: grid; gap: .3rem; align-content: start; }
  dd { margin: 0; color: var(--ink); line-height: 1.55; }
</style>
