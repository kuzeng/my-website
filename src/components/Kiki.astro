---
// Kiki, the assistant's face: a little Star White glass dumpling with a sprout.
// Reacts to the assistant state on its [data-assistant] ancestor: blinks when idle, eyes wide while listening,
// glances up while thinking, talks while speaking. --lvl (0..1, set by src/scripts/assistant.ts) drives the glow and mouth.
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<span class="kiki" style={`--size:${size}px`} aria-hidden="true" data-ai-level>
  <svg viewBox="0 0 40 40">
    <path class="stem" d="M20 3.2c0-2 .4-3.4 1.4-4.6" />
    <path class="leaf" d="M21.2-1.2c1.6-2.6 4.6-3.6 7-3-0.8 2.8-3.6 4.4-7 3z" />
    <ellipse class="cheek" cx="10.6" cy="24.6" rx="2.7" ry="1.7" />
    <ellipse class="cheek" cx="29.4" cy="24.6" rx="2.7" ry="1.7" />
    <g class="eyes">
      <ellipse class="eye" cx="14.6" cy="19" rx="2.3" ry="3.1" />
      <ellipse class="eye" cx="25.4" cy="19" rx="2.3" ry="3.1" />
      <circle class="glint" cx="15.4" cy="17.6" r=".8" />
      <circle class="glint" cx="26.2" cy="17.6" r=".8" />
    </g>
    <path class="mouth" d="M17.3 25.2q2.7 2.6 5.4 0" />
    <ellipse class="mouth-open" cx="20" cy="26" rx="2.4" ry="2.1" />
  </svg>
</span>

<style>
  .kiki {
    --lvl: 0;
    position: relative; flex: none; display: inline-block; width: var(--size); height: var(--size); border-radius: 50%;
    /* milky glass: bright top-left, warm Star White body, soft shade underneath */
    background: radial-gradient(circle at 34% 26%, #fff 0 16%, #f8f4ec 42%, #e8dfd1 100%);
    box-shadow:
      inset 0 -3px 6px rgb(120 96 64 / .2),
      inset 0 2px 2px rgb(255 255 255 / .95),
      0 0 0 .5px rgb(0 0 0 / .1),
      0 3px 10px -3px rgb(0 0 0 / .35),
      0 0 0 calc(var(--lvl) * var(--size) * .22) color-mix(in srgb, var(--signal) 30%, transparent);
    scale: calc(1 + var(--lvl) * .08);
    animation: float 3.4s ease-in-out infinite;
    transition: box-shadow .1s linear, scale .1s linear;
  }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .stem { fill: none; stroke: #2fa84f; stroke-width: 1.4; stroke-linecap: round; }
  .leaf { fill: var(--signal); }
  .cheek { fill: #ffab9c; opacity: .5; }
  .eye, .mouth-open { fill: #2a2622; }
  .glint { fill: #fff; }
  .mouth { fill: none; stroke: #2a2622; stroke-width: 1.7; stroke-linecap: round; transition: opacity .15s; }
  .mouth-open { opacity: 0; transform-box: fill-box; transform-origin: center; transform: scaleY(.3); transition: opacity .15s; }
  .eyes {
    transform-box: fill-box; transform-origin: center;
    animation: blink 5s infinite;
    transition: translate .35s cubic-bezier(.3, 1.4, .5, 1), scale .35s cubic-bezier(.3, 1.4, .5, 1);
  }

  @keyframes float { 50% { translate: 0 -1.5px; } }
  @keyframes blink { 0%, 93%, 100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
  @keyframes wobble { 0%, 100% { rotate: -5deg; } 50% { rotate: 5deg; } }

  /* Listening: eyes wide open */
  :global(.assistant[data-state="listening"]) .eyes { scale: 1.18; animation: none; }
  /* Thinking: glances up and sways */
  :global(.assistant[data-state="thinking"]) .eyes { translate: 1.4px -2.4px; animation: none; }
  :global(.assistant[data-state="thinking"]) .kiki { animation: wobble 1.1s ease-in-out infinite; }
  /* Speaking: the mouth opens with the voice level */
  :global(.assistant[data-state="speaking"]) .mouth { opacity: 0; }
  :global(.assistant[data-state="speaking"]) .mouth-open { opacity: 1; transform: scaleY(calc(.3 + var(--lvl) * 1.3)); }
</style>
