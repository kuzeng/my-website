---
// Jarvis: the site's AI assistant. A button under the phone (bottom-right on phones).
// Opening the chat on desktop is like Stage Manager: the phone shrinks to the left and the chat window sits on the right.
// Ask by voice (Web Speech API) or by typing; answers come from the assistant Worker in worker/.
// Not rendered until PUBLIC_ASSISTANT_API is set, so the site never shows a broken button.
import Jarvis from './Jarvis.astro';
const api = import.meta.env.PUBLIC_ASSISTANT_API;
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
{api && (
  <div class="assistant" data-assistant data-api={api} data-turnstile={turnstile} data-state="idle">
    <button class="orb-btn glass" type="button" aria-expanded="false" aria-controls="assistant-panel" data-orb>
      <Jarvis size={30} />
      <span class="orb-label" data-i18n="cta">Ask Jarvis</span>
    </button>

    <section class="panel glass" id="assistant-panel" aria-labelledby="assistant-title" hidden data-panel>
      <header class="head">
        <Jarvis size={36} />
        <div class="head-text">
          <h2 id="assistant-title" data-i18n="title">Jarvis</h2>
          <p data-i18n="subtitle">Kuiduan’s AI assistant · answers from what he’s shared</p>
        </div>
        <button class="icon-btn" type="button" data-close data-i18n-label="close" aria-label="Close">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </header>

      <p class="intro" data-intro data-i18n="intro">Good day. I’m Jarvis, Kuiduan’s assistant. Ask me about his work, his projects, or what he’s building at the moment. I only know what he’s shared with me, so a few things may be beyond me.</p>
      <ol class="log" data-log aria-live="polite"></ol>
      <div class="chips" data-chips></div>

      <form class="composer" data-form>
        <button class="icon-btn mic" type="button" data-mic data-i18n-label="mic" aria-label="Ask with your voice" aria-pressed="false" hidden>
          <svg width="16" height="18" viewBox="0 0 16 18" aria-hidden="true"><rect x="5" y="1" width="6" height="10" rx="3" fill="currentColor"/><path d="M2 8.5a6 6 0 0 0 12 0M8 14.5V17" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
        </button>
        <label class="sr-only" for="assistant-input" data-i18n="label">Your question</label>
        <input id="assistant-input" name="q" maxlength="500" autocomplete="off" enterkeyhint="send" data-input data-i18n-placeholder="placeholder" placeholder="Ask Jarvis about Kuiduan…" />
        <button class="icon-btn send" type="submit" data-i18n-label="send" aria-label="Send">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" stroke="currentColor" stroke-width="1.9" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>
      <p class="fine" data-i18n="fine">Questions are saved to improve the answers.</p>
      <div class="turnstile" data-turnstile-slot></div>
    </section>

    <div class="toast glass" role="status" data-toast hidden>
      <span data-toast-text></span>
      <button type="button" data-undo data-i18n="undo">Undo</button>
    </div>
  </div>
)}

<script>
  import '../scripts/assistant';
</script>

<style>
  /* No JS → no assistant (it needs the network and speech APIs anyway). */
  .assistant { display: none; }
  :global(html.js) .assistant { display: block; }

  .orb-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .55rem;
    min-width: 52px; min-height: 52px; padding: 0; border: 0; border-radius: 999px;
    color: var(--ink); font: inherit; font-size: var(--t-xs); font-weight: 600; letter-spacing: -.005em; cursor: pointer;
  }
  .orb-btn :global(.jarvis) { --size: 36px !important; }
  .orb-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---- Phones / tablets: a floating button above the tab bar; the panel is a bottom sheet ---- */
  .assistant { position: fixed; z-index: 60; right: 1rem; bottom: calc(.75rem + env(safe-area-inset-bottom) + 3.75rem); }
  .panel {
    position: fixed; z-index: 70; left: .75rem; right: .75rem; bottom: calc(.75rem + env(safe-area-inset-bottom));
    display: flex; flex-direction: column; max-height: min(78vh, 640px);
    border-radius: 26px; padding: .9rem .9rem .6rem;
    --glass-fill: color-mix(in srgb, var(--bg) 84%, transparent);
    transform-origin: 100% 100%;
    animation: materialize .38s cubic-bezier(.3, 1.4, .5, 1);
  }
  /* While the chat is open, its button steps aside (the panel has its own close button). */
  .assistant.is-open .orb-btn { opacity: 0; scale: .8; pointer-events: none; }
  .orb-btn { transition: opacity .3s ease, scale .3s ease, transform .45s cubic-bezier(.3, 1.6, .5, 1); }
  .panel[hidden] { display: none; }
  @keyframes materialize { from { opacity: 0; scale: .92; filter: blur(6px); } }

  /* ---- Unfolding phone (desktop): a pill centred in the space under the device; the panel rises from it ---- */
  @media (min-width: 1000px) and (min-height: 640px) {
    .assistant {
      --H: min(84vh, 860px, calc((100vw - 120px) / 1.4142)); /* same as .device in global.css */
      /* Full-width strip, centred with flex: a transform here would trap the fixed-position toast inside it. */
      position: absolute; left: 0; right: 0; display: flex; justify-content: center; pointer-events: none;
      bottom: max(6px, calc((100vh - var(--H)) / 4 - 22px));
    }
    :global(html.js) .assistant { display: flex; }
    .orb-btn, .panel, .toast { pointer-events: auto; }
    .orb-btn { min-height: 44px; padding: 0 1.1rem 0 .45rem; }
    .orb-btn :global(.jarvis) { --size: 30px !important; }
    .orb-label { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
    /* Stage Manager: the chat is its own window beside the phone. assistant.ts centres the two as one group (setting
       `right`) and shrinks the phone when space runs out; `right` glides in step with the phone when it (un)folds. */
    .panel {
      position: fixed; left: auto; right: 2rem; bottom: auto; top: 50%; translate: 0 -50%;
      width: clamp(320px, 30vw, 400px); height: min(680px, calc(100vh - 6rem)); max-height: none;
      padding: 1rem 1rem .7rem;
      transform-origin: 100% 50%;
      animation: slide-in .5s cubic-bezier(.3, 1.2, .4, 1);
      transition: right .6s cubic-bezier(.3, 1, .4, 1), box-shadow .3s ease, background-color .3s ease;
    }
    @keyframes slide-in { from { opacity: 0; transform: translateX(40px) scale(.96); filter: blur(6px); } }
  }

  /* ---- Panel contents ---- */
  .head { display: flex; align-items: center; gap: .7rem; padding: 0 .1rem .7rem; border-bottom: 1px solid var(--rule); }
  .head-text { flex: 1; min-width: 0; }
  .intro { margin-top: .85rem; padding: .6rem .8rem; border-radius: 18px 18px 18px 6px; align-self: flex-start; font-size: var(--t-sm); line-height: 1.45; color: var(--ink); background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .intro[hidden] { display: none; }
  .head h2 { font-size: var(--t-sm); font-weight: 600; letter-spacing: -.015em; line-height: 1.3; }
  .head p { font-size: .75rem; color: var(--muted); line-height: 1.35; }
  .icon-btn {
    display: inline-grid; place-items: center; flex: none; width: 40px; height: 40px; border: 0; border-radius: 50%;
    background: transparent; color: var(--muted); cursor: pointer; transition: background-color .2s, color .2s;
  }
  .icon-btn:hover { background: color-mix(in srgb, var(--ink) 7%, transparent); color: var(--ink); }

  .log { list-style: none; margin: 0; padding: .8rem .1rem .2rem; flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; gap: .55rem; }
  .log:empty { display: none; }
  .log :global(.msg) { max-width: 88%; padding: .5rem .8rem; border-radius: 18px; font-size: var(--t-sm); line-height: 1.45; overflow-wrap: anywhere; }
  .log :global(.msg.user) { align-self: flex-end; background: var(--ink); color: var(--bg); border-bottom-right-radius: 6px; }
  .log :global(.msg.bot) { align-self: flex-start; background: color-mix(in srgb, var(--ink) 6%, transparent); color: var(--ink); border-bottom-left-radius: 6px; }
  .log :global(.msg.bot.error) { color: var(--muted); }
  .log :global(.typing) { display: inline-flex; gap: 4px; padding-block: .35rem; }
  .log :global(.typing i) { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: dot 1s ease-in-out infinite; }
  .log :global(.typing i:nth-child(2)) { animation-delay: .15s; }
  .log :global(.typing i:nth-child(3)) { animation-delay: .3s; }
  @keyframes dot { 50% { opacity: .3; translate: 0 -2px; } }
  .log :global(.see) {
    align-self: flex-start; display: inline-flex; align-items: center; min-height: 32px; margin-top: -.2rem; padding: 0 .75rem;
    border-radius: 999px; font-size: var(--t-xs); font-weight: 500; color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--rule); transition: background-color .2s;
  }
  .log :global(.see:hover) { background: color-mix(in srgb, var(--ink) 6%, transparent); }

  /* Lead form: shown when the assistant couldn't answer */
  .log :global(.lead) { align-self: stretch; display: grid; gap: .45rem; padding: .75rem; border-radius: 16px; box-shadow: inset 0 0 0 1px var(--rule); }
  .log :global(.lead p) { font-size: var(--t-xs); color: var(--ink-2); }
  .log :global(.lead .two) { display: grid; grid-template-columns: 1fr 1fr; gap: .45rem; }
  .log :global(.lead input), .composer input {
    width: 100%; min-width: 0; min-height: 40px; padding: 0 .85rem; border: 0; border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 6%, transparent); color: var(--ink); font: inherit; font-size: var(--t-sm);
  }
  .log :global(.lead input:focus-visible), .composer input:focus-visible { outline: 2px solid var(--ink); outline-offset: 0; }
  .log :global(.lead button) { justify-self: end; min-height: 36px; padding: 0 1rem; border: 0; cursor: pointer; font: inherit; }
  .log :global(.lead .done) { color: var(--ink); font-size: var(--t-sm); }

  .chips { display: flex; flex-wrap: wrap; gap: .4rem; padding: .8rem .1rem .2rem; }
  .chips:empty { display: none; }
  .chips :global(button) {
    min-height: 36px; padding: 0 .85rem; border: 0; border-radius: 999px; cursor: pointer;
    background: color-mix(in srgb, var(--ink) 6%, transparent); color: var(--ink); font: inherit; font-size: var(--t-xs); font-weight: 500;
    transition: background-color .2s;
  }
  .chips :global(button:hover) { background: color-mix(in srgb, var(--ink) 11%, transparent); }

  .composer { display: flex; align-items: center; gap: .35rem; margin-top: auto; padding-top: .7rem; } /* pinned to the bottom of the window */
  .composer input { flex: 1; min-height: 44px; }
  .send { background: var(--ink); color: var(--bg); }
  .send:hover { background: var(--ink); color: var(--bg); opacity: .85; }
  .mic[aria-pressed="true"] { background: #ff375f; color: #fff; }
  .assistant[data-state="thinking"] .send { opacity: .4; pointer-events: none; }
  .fine { margin-top: .45rem; text-align: center; font-size: .6875rem; color: var(--muted); }
  .turnstile:empty { display: none; }
  .turnstile { display: flex; justify-content: center; margin-top: .4rem; }

  /* "Showing Experience · Undo" after the assistant moved the page */
  .toast {
    position: fixed; z-index: 80; left: 50%; top: calc(.75rem + env(safe-area-inset-top)); translate: -50% 0;
    display: flex; align-items: center; gap: .6rem; padding: .35rem .4rem .35rem 1rem; border-radius: 999px;
    font-size: var(--t-xs); font-weight: 500; color: var(--ink); white-space: nowrap;
    animation: materialize .38s cubic-bezier(.3, 1.4, .5, 1);
  }
  .toast[hidden] { display: none; }
  .toast button { min-height: 32px; padding: 0 .8rem; border: 0; border-radius: 999px; cursor: pointer; font: inherit; font-weight: 600; background: color-mix(in srgb, var(--ink) 8%, transparent); color: var(--ink); }
  @media (min-width: 1000px) and (min-height: 640px) {
    .toast { top: max(8px, calc((100vh - min(84vh, 860px, calc((100vw - 120px) / 1.4142))) / 4 - 20px)); }
  }
</style>
