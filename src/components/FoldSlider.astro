---
// "slide to unfold": a nod to the original iPhone's "slide to unlock". Desktop device only.
// Glass track (control layer) with a solid knob on top: iOS 26 never stacks glass on glass.
---
<div class="unfold glass" data-slider="open">
  <button class="knob" type="button" data-knob aria-label="Unfold to see more about Kuiduan" aria-controls="device">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <span class="label" aria-hidden="true">slide to unfold</span>
</div>

<style>
  @media (min-width: 1000px) and (min-height: 640px) {
    .unfold {
      display: flex; align-items: center; flex: none;
      height: 58px; padding: 5px; border-radius: 999px;
      touch-action: none;
    }
    .knob {
      position: relative; z-index: 1; flex: none; display: grid; place-items: center;
      width: 48px; height: 48px; border: 0; border-radius: 50%;
      background: var(--ink); color: var(--bg); cursor: grab;
      transform: translateX(var(--knob-x, 0px));
      transition: transform .35s cubic-bezier(.3, 1.4, .5, 1);
      box-shadow: 0 4px 12px -4px rgb(0 0 0 / .35), inset 0 1px 0 rgb(255 255 255 / .18);
    }
    .knob:active { cursor: grabbing; }
    :global(.device.dragging) .knob { transition: none; }
    .label {
      position: absolute; inset: 0; display: grid; place-items: center; padding-left: 40px; pointer-events: none;
      font-size: var(--t-sm); font-weight: 500; letter-spacing: -.005em;
      color: transparent;
      background: linear-gradient(100deg, var(--muted) 0 40%, var(--ink) 50%, var(--muted) 60% 100%) 0 0 / 250% 100%;
      -webkit-background-clip: text; background-clip: text;
      animation: shimmer 2.8s linear infinite;
      opacity: calc(1 - var(--p, 0) * 2.2);
    }
    @keyframes shimmer { from { background-position: 100% 0; } to { background-position: -150% 0; } }
  }
</style>
