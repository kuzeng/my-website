---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import { profile } from '../data/profile';
import { education } from '../data/education';
import Icon from '../components/Icon.astro';
import Tabs from '../components/Tabs.astro';
import Assistant from '../components/Assistant.astro';

interface Props { title?: string; description?: string; ogType?: string }
const { title, description = profile.seoDescription, ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · iOS Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const isHome = Astro.url.pathname === '/';
const base = isHome ? '' : '/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: profile.site,
  email: `mailto:${profile.email}`,
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: profile.company },
  address: { '@type': 'PostalAddress', addressLocality: 'Santa Clara', addressRegion: 'CA', addressCountry: 'US' },
  alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  knowsAbout: ['iOS development', 'Swift', 'SwiftUI', 'UIKit', 'Mobile architecture', 'Accessibility', 'Developer tooling'],
  sameAs: [profile.linkedin, profile.github],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#dcd8cf" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131312" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, iOS Engineer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="stage">
      <div class="device is-open" id="device">
        <div class="flap">
          <!-- Outer display (what you see folded) -->
          <div class="face back" id="cover">
            <div class="bezel"><div class="screen">
              <div class="hw sbar" aria-hidden="true"><span data-clock>9:41</span><span class="icons"><svg width="17" height="11" viewBox="0 0 17 11"><rect x="0" y="7" width="3" height="4" rx=".7" fill="currentColor"/><rect x="4.6" y="5" width="3" height="6" rx=".7" fill="currentColor"/><rect x="9.2" y="2.6" width="3" height="8.4" rx=".7" fill="currentColor"/><rect x="13.8" y="0" width="3" height="11" rx=".7" fill="currentColor"/></svg><svg width="15" height="11" viewBox="0 0 15 11"><path d="M7.5 2.2c2.2 0 4.2.85 5.7 2.25l1.1-1.13A9.6 9.6 0 0 0 7.5.6 9.6 9.6 0 0 0 .7 3.32L1.8 4.45A8 8 0 0 1 7.5 2.2Zm0 3.2c1.3 0 2.5.5 3.4 1.33l1.1-1.13A6.4 6.4 0 0 0 7.5 3.8 6.4 6.4 0 0 0 3 5.6l1.1 1.13A4.8 4.8 0 0 1 7.5 5.4Zm0 3.2c.5 0 .9.18 1.2.47L7.5 10.3 6.3 9.07c.3-.29.7-.47 1.2-.47Z" fill="currentColor"/></svg><svg width="25" height="12" viewBox="0 0 25 12"><rect x=".5" y=".5" width="21" height="11" rx="3.2" fill="none" stroke="currentColor" opacity=".4"/><rect x="2" y="2" width="15" height="8" rx="2" fill="currentColor"/><path d="M23 4v4c.8-.3 1.3-1.1 1.3-2S23.8 4.3 23 4Z" fill="currentColor" opacity=".4"/></svg></span></div>
              <span class="hw cam" aria-hidden="true"></span>
              <header class="cover-screen"><slot name="cover" /></header>
              <span class="hw home" aria-hidden="true"></span>
            </div></div>
          </div>
          <!-- Left half of the inner display -->
          <div class="face front" id="about-face">
            <div class="bezel"><div class="screen">
              <aside class="pane pane-left" aria-label="About"><slot name="about" /></aside>
              <p class="hw fold-hint glass" data-fold-hint role="status">Swipe left or press Esc to fold</p>
            </div></div>
          </div>
        </div>

        <!-- Right half of the inner display (the half that stays put) -->
        <div class="half half-r" id="content-half">
          <div class="bezel"><div class="screen">
            <div class="hw sbar sbar-inner" aria-hidden="true"><span class="ai-mini" data-ai-indicator data-ai-state="idle"><span class="ai-wave" data-ai-level><i></i><i></i><i></i><i></i><i></i></span></span><span data-clock>9:41</span><span class="icons"><svg width="17" height="11" viewBox="0 0 17 11"><rect x="0" y="7" width="3" height="4" rx=".7" fill="currentColor"/><rect x="4.6" y="5" width="3" height="6" rx=".7" fill="currentColor"/><rect x="9.2" y="2.6" width="3" height="8.4" rx=".7" fill="currentColor"/><rect x="13.8" y="0" width="3" height="11" rx=".7" fill="currentColor"/></svg><svg width="15" height="11" viewBox="0 0 15 11"><path d="M7.5 2.2c2.2 0 4.2.85 5.7 2.25l1.1-1.13A9.6 9.6 0 0 0 7.5.6 9.6 9.6 0 0 0 .7 3.32L1.8 4.45A8 8 0 0 1 7.5 2.2Zm0 3.2c1.3 0 2.5.5 3.4 1.33l1.1-1.13A6.4 6.4 0 0 0 7.5 3.8 6.4 6.4 0 0 0 3 5.6l1.1 1.13A4.8 4.8 0 0 1 7.5 5.4Zm0 3.2c.5 0 .9.18 1.2.47L7.5 10.3 6.3 9.07c.3-.29.7-.47 1.2-.47Z" fill="currentColor"/></svg><svg width="25" height="12" viewBox="0 0 25 12"><rect x=".5" y=".5" width="21" height="11" rx="3.2" fill="none" stroke="currentColor" opacity=".4"/><rect x="2" y="2" width="15" height="8" rx="2" fill="currentColor"/><path d="M23 4v4c.8-.3 1.3-1.1 1.3-2S23.8 4.3 23 4Z" fill="currentColor" opacity=".4"/></svg></span></div>
            <span class="hw udc" aria-hidden="true"></span>
            <div class="pane pane-right" id="content">
              <main id="main" tabindex="-1">
                <slot />
              </main>
              <footer class="site-footer" id="contact" aria-labelledby="contact-title">
                <div class="container">
                  <h2 class="display footer-line" id="contact-title">Say hello. <span class="tone">The best way to reach me is email.</span></h2>
                  <p class="footer-mail"><a class="underline" href={`mailto:${profile.email}`}>{profile.email}</a></p>
                  <ul class="footer-links">
                    <li><a class="more" href={profile.linkedin} rel="me noopener">LinkedIn</a></li>
                    <li><a class="more" href={profile.github} rel="me noopener">GitHub</a></li>
                  </ul>
                  <div class="colophon">
                    <p>© {new Date().getFullYear()} {profile.name}</p>
                    <p>Designed in the Bay Area. Built with Astro and Claude Code.</p>
                  </div>
                </div>
              </footer>
            </div>
            <Tabs />
          </div></div>
        </div>

        <span class="hw notch top" aria-hidden="true"></span>
        <span class="hw notch bottom" aria-hidden="true"></span>
        <span class="hw home-inner" aria-hidden="true"></span>
        <span class="hw side-btn" aria-hidden="true"></span>
        <span class="hw top-btns" aria-hidden="true"></span>
      </div>
      <Assistant />
    </div>
    <script is:inline>
      // Start folded (before first paint) unless a deep link asks for something inside.
      (function () {
        var d = document.getElementById('device');
        document.documentElement.classList.add('js');
        if (!location.hash || location.hash === '#cover') {
          d.classList.add('no-anim');
          d.classList.remove('is-open');
          requestAnimationFrame(function () { requestAnimationFrame(function () { d.classList.remove('no-anim'); }); });
        }
      })();
    </script>
    <script>
      import '../scripts/fold';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
  .site-footer { padding-block: var(--s-8) calc(var(--s-6) + 4.5rem); }
  @media (min-width: 1000px) and (min-height: 640px) { .site-footer { padding-bottom: 7rem; } }
  .footer-line { font-size: var(--t-lg); letter-spacing: -.03em; max-width: 22ch; }
  .footer-mail { margin-top: var(--s-6); font-size: var(--t-md); font-weight: 500; letter-spacing: -.02em; overflow-wrap: anywhere; }
  .footer-links { list-style: none; padding: 0; margin-top: var(--s-3); display: flex; flex-wrap: wrap; gap: 0 var(--s-6); }
  /* Assistant activity in the inner status bar, beside the clock (a Live Activity in miniature) */
  .ai-mini {
    display: inline-flex; align-items: center; height: 18px; padding: 0 8px; margin-right: .55rem; border-radius: 999px;
    background: var(--island); opacity: 0; scale: .6; filter: blur(3px);
    transition: opacity .35s ease, scale .45s cubic-bezier(.3, 1.5, .5, 1), filter .35s ease;
  }
  .ai-mini:not([data-ai-state="idle"]) { opacity: 1; scale: 1; filter: none; }
  .colophon { margin-top: var(--s-8); padding-top: var(--s-4); border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-5); font-size: var(--t-xs); color: var(--muted); }
</style>
